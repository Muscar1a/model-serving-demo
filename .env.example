KAFKA_CLUSTER_ID=your_kafka_cluster_id

# SeaweedFS / S3 config
S3_ENDPOINT=http://stream-project-seaweedfs:8333
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET_NAME=your_s3_bucket_name

# Elasticsearch config
ES_JAVA_MEM=your_elasticsearch_java_memory_allocation
ES_NODES=stream-project-elasticsearch
ES_PORT=9200
ES_INDEX=heart-disease-stream

# Kafka config
KAFKA_BOOTSTRAP_SERVERS=stream-project-kafka:19092
KAFKA_TOPIC=heart-disease-stream
